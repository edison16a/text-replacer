{
  "name": "text-replacer-extension",
  "version": "8.0.0",
  "private": true,
  "description": "Chrome extension that replaces webpage text and images with your own",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "node tools/validate-data.mjs",
    "extract": "node tools/extract-theme.mjs && node tools/extract-strings.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "typescript": "^5.9.3"
  }
}
